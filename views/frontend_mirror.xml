<odoo>
    <template id='frontend_mirror' name="Mirror Account">        
        <t t-call="web.frontend_layout">
            <t t-set="no_footer" t-value="true"/>
            
            <t t-set="google_maps_gps_mapid" t-value="request.env['ir.config_parameter'].sudo().get_param('gps_mapid')"/>            
            <t t-if="google_maps_gps_mapid">
                <script> window.GOOGLE_MAP_ID = "<t t-esc='google_maps_gps_mapid'/>";</script>                
            </t>
            
            <t t-set="google_maps_api_key" t-value="request.env['ir.config_parameter'].sudo().get_param('base_geolocalize.google_map_api_key')"/>
            <t t-if="google_maps_api_key">
                <script t-attf-src="https://maps.googleapis.com/maps/api/js?key=#{google_maps_api_key}&amp;libraries=marker"></script>
                
            </t>
            <t t-if="not google_maps_api_key">
                <script t-attf-src="https://maps.googleapis.com/maps/api/js?v=quarterly&amp;key=#{google_maps_api_key}&amp;libraries=#{google_maps_libraries}#{'&amp;language=' + google_maps_lang_localization if google_maps_lang_localization else ''}#{'&amp;region=' + google_maps_region_localization if google_maps_region_localization else ''}"></script>
            </t>
            
            <div id="controller_gpsmap" style="position:relative; width:100%; height:100%;">                                                
                <t t-call="gpsmap.frontend_mirror_menu"/>
                <div id="maponline" style="top:0px; left:250px; width: calc(100% - 250px); height:100%;"/>  
                <div id="tableros" class="o_main_navbar" style="z-index:100; font-size:25px; text-align:left; position:absolute; bottom:0px; left:0px; width:100%; height:70px; color:#ccc; padding:10px;"/>
                <t t-call="gpsmap.frontend_mirror_odometers"/>
            </div>
        </t>
    </template>

</odoo>
